			<link>https://www.ajnet.me/politics/2026/10/29/%D8%B9%D9%83%D8%B1%D9%85%D8%A9-%D8%B5%D8%A8%D8%B1%D9%8A-%D9%84%D9%84%D8%AC%D8%B2%D9%8A%D8%B1%D8%A9-%D8%A7%D9%84%D8%A7%D8%AD%D8%AA%D9%84%D8%A7%D9%84-%D8%A7%D9%84%D8%A3%D9%82%D8%B5%D9%89</link>
