			<guid isPermaLink="false">1791280935141396</guid>
		</item>
		<item>
			<title>بن غفير يقود عملية هدم بناية سكنية في بلدة الطور شرقي القدس</title>
			<link>https://www.ajnet.me/news/2026/10/6/%D8%A8%D9%86-%D8%BA%D9%81%D9%8A%D8%B1-%D9%8A%D9%82%D9%88%D8%AF-%D9%87%D8%AF%D9%85-%D8%A8%D9%86%D8%A7%D9%8A%D8%A9-%D8%B3%D9%83%D9%86%D9%8A%D8%A9-%D9%81%D9%8A-%D8%A8%D9%84%D8%AF%D8%A9</link>
