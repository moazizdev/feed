		<item>
			<title>"سنحرقكم!".. ماذا يحدث لقرى الفلسطينيين في الضفة؟</title>
			<link>https://www.ajnet.me/news/2026/8/20/%D8%B3%D9%86%D8%AD%D8%B1%D9%82%D9%83%D9%85-%D9%85%D8%A7%D8%B0%D8%A7-%D9%8A%D8%AD%D8%AF%D8%AB-%D9%84%D9%82%D8%B1%D9%89-%D8%A7%D9%84%D9%81%D9%84%D8%B3%D8%B7%D9%8A%D9%86%D9%8A%D9%8A%D9%86</link>
