			<link>https://www.ajnet.me/politics/2026/7/28/%D8%A7%D9%84%D9%82%D8%AF%D8%B3-%D9%81%D9%84%D8%B3%D8%B7%D9%8A%D9%86-%D9%85%D8%B3%D8%AA%D9%88%D8%B7%D9%86%D9%8A%D9%86-%D8%AA%D9%84-%D9%87%D8%AC%D9%88%D9%85-%D8%A5%D8%B1%D9%87%D8%A7%D8%A8</link>
