		<item>
			<title>الحاخام غابرييل هاغاي يتحدث لـ"أثير" عن المشروع الصهيوني و"نهاية إسرائيل"</title>
			<link>https://www.ajnet.me/politics/2026/9/18/%D8%A7%D9%84%D8%AD%D8%A7%D8%AE%D8%A7%D9%85-%D8%BA%D8%A7%D8%A8%D8%B1%D9%8A%D9%8A%D9%84-%D9%87%D8%A7%D8%BA%D8%A7%D9%8A-%D9%8A%D8%AA%D8%AD%D8%AF%D8%AB-%D9%84%D9%80%D8%A3%D8%AB%D9%8A%D8%B1-2</link>
