		<item>
			<title>ماذا تكشف صور الأقمار الصناعية في غزة؟</title>
			<link>https://www.ajnet.me/politics/2026/9/29/%D8%A5%D8%B3%D8%B1%D8%A7%D8%A6%D9%8A%D9%84-%D8%AA%D9%82%D8%B6%D9%85-%D8%A3%D8%B1%D8%A7%D8%B6%D9%8A-%D8%BA%D8%B2%D8%A9-%D9%88%D8%A7%D9%84%D8%A3%D9%82%D9%85%D8%A7%D8%B1</link>
