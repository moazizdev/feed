		<item>
			<title>إلى أين وصلت مساعي المستوطنين لاقتحام المسجد الأقصى أيام السبت؟</title>
			<link>https://www.ajnet.me/politics/2026/10/21/%D8%A7%D9%84%D9%82%D8%AF%D8%B3-%D8%A7%D9%84%D8%A3%D9%82%D8%B5%D9%89-%D8%A7%D9%82%D8%AA%D8%AD%D8%A7%D9%85-%D9%81%D9%84%D8%B3%D8%B7%D9%8A%D9%86-%D9%85%D8%B3%D8%AA%D9%88%D8%B7%D9%86%D9%88%D9%86</link>
