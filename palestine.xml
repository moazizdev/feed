			<link>https://www.ajnet.me/politics/2026/10/7/%D9%85%D9%86%D9%82%D8%B0%D9%88%D9%86-%D9%81%D9%8A-%D8%BA%D8%B2%D8%A9-%D9%8A%D9%86%D8%A8%D8%B4%D9%88%D9%86-%D8%A7%D9%84%D9%85%D9%88%D8%AA-%D9%81%D8%AA%D9%88%D9%84%D8%AF-%D8%AD%D9%8A%D8%A7%D8%A9</link>
