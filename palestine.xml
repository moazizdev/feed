		<item>
			<title>"وباء داخل الخيام".. جدري الماء ينهش أجساد أطفال غزة</title>
			<link>https://www.ajnet.me/news/2026/8/9/%D9%88%D8%A8%D8%A7%D8%A1-%D8%AF%D8%A7%D8%AE%D9%84-%D8%A7%D9%84%D8%AE%D9%8A%D8%A7%D9%85-%D8%AC%D8%AF%D8%B1%D9%8A-%D8%A7%D9%84%D9%85%D8%A7%D8%A1-%D9%8A%D9%86%D9%87%D8%B4</link>
