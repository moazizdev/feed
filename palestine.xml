			<link>https://www.ajnet.me/politics/2026/10/17/%D9%84%D9%84%D9%8A%D9%88%D9%85-%D8%A7%D9%84%D9%80-114-%D8%A7%D9%84%D8%A3%D8%B0%D8%A7%D9%86-%D9%85%D9%85%D9%86%D9%88%D8%B9-%D8%A8%D8%A7%D9%84%D8%AD%D8%B1%D9%85</link>
