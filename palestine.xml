			<link>https://www.ajnet.me/news/2026/8/12/%D8%BA%D8%B6%D8%A8-%D8%A8%D9%8A%D9%86-%D8%AC%D9%86%D9%88%D8%AF-%D8%A7%D9%84%D8%A7%D8%AD%D8%AA%D9%84%D8%A7%D9%84-%D9%88%D9%82%D9%84%D9%82-%D8%A8%D9%88%D8%A7%D8%B4%D9%86%D8%B7%D9%86</link>
