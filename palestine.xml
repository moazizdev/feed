			<link>https://www.ajnet.me/politics/2026/8/10/%D8%A7%D9%84%D8%A7%D8%AD%D8%AA%D9%84%D8%A7%D9%84-%D9%8A%D8%B3%D8%AA%D8%AE%D8%AF%D9%85-%D9%85%D8%B1%D8%A7%D9%87%D9%82%D9%8A%D9%86-%D9%82%D8%A7%D8%B5%D8%B1%D9%8A%D9%86</link>
