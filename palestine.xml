		<item>
			<title>"العنقاء".. فلسطيني يحوّل خشب الزيتون إلى تحف فنية</title>
			<link>https://www.ajnet.me/arts/2026/9/17/%D8%AF%D8%A7%D8%AE%D9%84-%D8%A7%D9%84%D8%B9%D9%86%D9%82%D8%A7%D8%A1-%D8%A3%D8%B3%D9%8A%D8%B1-%D9%85%D8%AD%D8%B1%D8%B1-%D9%8A%D8%A8%D8%B9%D8%AB-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9-%D9%81%D9%8A</link>
